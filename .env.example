# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
MAX_TOKENS=800
TEMPERATURE=0.0
LLM_TIMEOUT=120

# Existing embedding model
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K=5
SCORE_THRESHOLD=0.0
MAX_CONTEXT_CHARS=16000
CHUNKS_PATH=data/chunks/chunks.json

# Preferred: Supabase direct/pooler PostgreSQL URL
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Used only when DATABASE_URL is empty
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_SCHEMA=public
DB_TABLE=chunks
