# Ollama (no secret API key is required)
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3
MAX_TOKENS=800
TEMPERATURE=0.0
LLM_TIMEOUT=120
OLLAMA_REASONING_EFFORT=none

# Existing embedding model
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K=5
SCORE_THRESHOLD=0.0
MAX_CONTEXT_CHARS=16000
CHUNKS_PATH=data/chunks/chunks.json

# Retrieval Reranking (optional)
# Set RERANKER_MODEL to any HuggingFace cross-encoder model (e.g. cross-encoder/ms-marco-MiniLM-L-6-v2)
ENABLE_RERANKING=false
RERANKER_MODEL=
RERANK_CANDIDATE_K=20
FINAL_TOP_K=5

# LLM-as-a-Judge Verification (optional)
ENABLE_JUDGE=false
JUDGE_MODEL=qwen/qwen3.5-122b-a10b
JUDGE_MAX_TOKENS=1200
MAX_REGENERATE_ATTEMPTS=2

# Preferred: Supabase direct/pooler PostgreSQL URL
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Used only when DATABASE_URL is empty
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_SCHEMA=public
DB_TABLE=chunks

